# UniAPI 的核心配置文件路径 (绝对路径)
API_YAML_PATH=/path/to/your/api.yaml

# UniAPI 生成的统计数据库文件路径 (绝对路径)
# Database configuration (choose either sqlite or postgres)
STATS_DB_TYPE=sqlite
STATS_DB_PATH=/path/to/your/data/stats.db

# PostgreSQL connection settings (only used if STATS_DB_TYPE is postgres)
STATS_DB_HOST=localhost
STATS_DB_PORT=5432
STATS_DB_USER=postgres
STATS_DB_PASSWORD=mysecretpassword
STATS_DB_NAME=postgres

# uni-api 服务地址（用于「uni-api 真实测试」），OpenAI 兼容前缀
UNI_API_BASE_URL=http://localhost:9210/v1

# 本地开发端口由 package.json 的 dev 脚本 `-p` 指定（默认 19212）。
# 注意：Next.js 的 `next dev` 不会读取 .env 中的 PORT。