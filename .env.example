# docker-compose.yml 用到的环境变量模板
# 复制为 .env 后按机器填写：cp .env.example .env
# .env 不进仓库（.gitignore 已挡）

# 容器内访问外部渠道的代理
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,10.0.0.10

# 请求转储的磁盘保留水位（单位基点为万分之一，300 = 3%）
RUST_REQUEST_SPOOL_DISK_RESERVE_BPS=

# 端口绑定（可选；不设则默认 0.0.0.0:9210）
UNI_API_BIND=0.0.0.0
UNI_API_PORT=9210
